---
interface Props {
  label: string;
  btn_id?: string,
}

const { label, btn_id } = Astro.props;
---

<button id={btn_id}
  class="px-4 py-2 bg-blue-500 text-white font-semibold rounded-md shadow hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-opacity-50"
>
  {label}
</button>