---
interface Props {
    text_area_id : string,
}

const {text_area_id} = Astro.props;
---


<textarea 
    id={text_area_id}  
    class="w-full h-40 p-4 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
    placeholder="Enter your message here..."
>
</textarea>